cmake_minimum_required(VERSION 3.28)

# Toolchain file for a plain GNU arm-none-eabi toolchain found in PATH,
# e.g. Debian/Ubuntu packages gcc-arm-none-eabi, libnewlib-arm-none-eabi, libstdc++-arm-none-eabi-newlib.
#
# Unlike arm-none-eabi_mcuxpresso.cmake this file does not need an MCUXpresso installation
# (no LinkServer/redlink). Flashing and debugging is done with external tools (e.g. OpenOCD/pyOCD via CMSIS-DAP).
# Compiler, linker and assembler flags are shared with the MCUXpresso toolchain file.
#
# Usage:
#   cmake --preset arm -DCMAKE_TOOLCHAIN_FILE=../cmake/toolchains/arm-none-eabi_gnu.cmake
#   cmake --build --preset release-arm

set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_VERSION 1)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON) # Creates compile_commands.json file for easier debugging and IDE support
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY) # Prevent CMake from trying to link executables during compiler tests

set(TARGET_TRIPLET "arm-none-eabi")

find_program(CMAKE_C_COMPILER   ${TARGET_TRIPLET}-gcc     REQUIRED)
find_program(CMAKE_CXX_COMPILER ${TARGET_TRIPLET}-g++     REQUIRED)
set(CMAKE_ASM_COMPILER ${CMAKE_C_COMPILER})
find_program(CMAKE_OBJCOPY      ${TARGET_TRIPLET}-objcopy REQUIRED)
find_program(CMAKE_OBJDUMP      ${TARGET_TRIPLET}-objdump REQUIRED)
find_program(CMAKE_AR           ${TARGET_TRIPLET}-ar      REQUIRED)
find_program(CMAKE_STRIP        ${TARGET_TRIPLET}-strip   REQUIRED)
find_program(CMAKE_SIZE         ${TARGET_TRIPLET}-size    REQUIRED)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# Reuse the compiler, linker and assembler flags of the MCUXpresso toolchain file
set(TOOLCHAIN_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(FLAGS_DIR "${TOOLCHAIN_DIR}/arm-none-eabi_mcuxpresso")
include("${FLAGS_DIR}/flags_compiler.cmake")
include("${FLAGS_DIR}/flags_linker.cmake")
include("${FLAGS_DIR}/flags_assembler.cmake")

# The linker scripts (generated by MCUXpresso) reference the MCUXpresso library "libcr_newlib_nohost.a"
# (syscall stubs without semihosting). Provide newlib's libnosys.a under that name instead.
execute_process(
    COMMAND ${CMAKE_C_COMPILER} -mcpu=cortex-m0 -mthumb -print-file-name=libnosys.a
    OUTPUT_VARIABLE GNU_LIBNOSYS OUTPUT_STRIP_TRAILING_WHITESPACE)
if(EXISTS "${GNU_LIBNOSYS}")
    set(GNU_STUB_DIR "${CMAKE_BINARY_DIR}/arm-none-eabi_gnu-stubs")
    file(MAKE_DIRECTORY "${GNU_STUB_DIR}")
    file(COPY_FILE "${GNU_LIBNOSYS}" "${GNU_STUB_DIR}/libcr_newlib_nohost.a" ONLY_IF_DIFFERENT)
    string(APPEND LINKER_FLAGS " -L${GNU_STUB_DIR}")
else()
    message(WARNING "libnosys.a not found, linking executables may fail (missing libcr_newlib_nohost.a)")
endif()
include("${FLAGS_DIR}/flags_set_init.cmake")
include("${FLAGS_DIR}/flags_override_with_init.cmake")
